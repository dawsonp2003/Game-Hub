# Optional: enables AI prompt generation for the Tier List game
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Google Images search for tier list card images (recommended)
# Serper: https://serper.dev — 2,500 free queries, then ~$50/50k
SERPER_API_KEY=

# Optional alternative to Serper (used if SERPER_API_KEY is not set)
# Brave Search API: https://brave.com/search/api — ~$5/month free credits
# BRAVE_SEARCH_API_KEY=

# Optional: comma-separated model fallback chain (default: gemini-2.5-flash-lite,gemini-2.0-flash-lite,gemini-2.0-flash)
# GEMINI_MODELS=gemini-2.0-flash-lite,gemini-2.0-flash
