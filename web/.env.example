# WebSocket URL for multiplayer signaling (production)
# Use the full hostname — NOT just the service name
VITE_SIGNALING_URL=game-arcade-signaling.onrender.com

# Supabase (accounts + cloud stats). Leave blank to run fully offline /
# guest-only — the app degrades gracefully and skips login + cloud sync.
# Find these in Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
